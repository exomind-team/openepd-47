---
import {
  ArrowRight,
  ArrowUpRight,
  BookOpen,
  Download,
  Fingerprint,
  GitFork,
  Hand,
  ShieldCheck,
  Zap,
} from 'lucide-astro';
import HomeProjectRail from '../components/HomeProjectRail.astro';
import ScreenSchematic from '../components/ScreenSchematic.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = (value: string) => `${base}${value}`;

const resources = [
  {
    type: 'DISPLAY',
    title: 'E0470A01-AF-S 规格书',
    note: '4.7" · 684 × 1216 · B/W',
    href: path('/resources/'),
  },
  {
    type: 'TOUCH',
    title: 'GT911 触摸资料',
    note: '官方组件 · I²C · 5-point',
    href: path('/hardware/gt911/'),
  },
  {
    type: 'POWER',
    title: 'TPS65185 电源资料',
    note: '电源时序 · 状态检查',
    href: path('/hardware/power/'),
  },
];
---

<SiteLayout
  title="OpenEPD 4.7 — 电子纸开放资料与开发门户"
  description="4.7 英寸 684×1216 电子纸的开放资料、ESP-IDF 驱动计划与社区项目展示。"
>
  <section class="hero-stage">
    <div class="hero shell">
      <div class="hero-copy reveal">
        <p class="eyebrow"><span>OPEN HARDWARE</span> / DOCUMENTED IN PUBLIC</p>
        <h1><span>OpenEPD 4.7</span>一块屏幕，<br />一套持续生长的开放资料。</h1>
        <p class="hero-lede">
          为 684×1216 黑白电子纸建立一个可信的起点：
          资料可追踪、驱动可复现、作品可被看见。
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href={path('/quick-start/')}>
            开始开发
            <ArrowRight size={18} aria-hidden="true" />
          </a>
          <a class="button button-secondary" href={path('/resources/')}>
            浏览资料
            <Download size={17} aria-hidden="true" />
          </a>
        </div>
        <dl class="hero-specs" aria-label="核心规格">
          <div><dt>尺寸</dt><dd>4.7"</dd></div>
          <div><dt>像素</dt><dd>684 × 1216</dd></div>
          <div><dt>触摸</dt><dd>GT911</dd></div>
          <div><dt>主控</dt><dd>ESP32-S3</dd></div>
        </dl>
      </div>
      <div class="hero-visual reveal reveal-delay">
        <ScreenSchematic />
      </div>
    </div>
    <HomeProjectRail />
  </section>

  <section class="manifest-section">
    <div class="shell manifest-grid">
      <div class="manifest-copy">
        <p class="eyebrow">AVAILABLE MATERIALS / 现有资料</p>
        <h2>已整理的硬件资料</h2>
        <p>
          这里包括 E0470A01-AF-S 规格书、结构图、GT911 触摸资料和 TPS65185 电源资料。
          每项都标注型号、来源、再分发状态和 SHA‑256。
        </p>
        <div class="trust-row">
          <span><Fingerprint size={18} aria-hidden="true" />108 项哈希可核验</span>
          <span><ShieldCheck size={18} aria-hidden="true" />公开边界已标注</span>
        </div>
        <a class="inline-action" href={path('/resources/')}>
          打开资料中心 <ArrowRight size={17} aria-hidden="true" />
        </a>
      </div>

      <div class="resource-ledger" aria-label="精选资料">
        {
          resources.map((resource, index) => (
            <a href={resource.href}>
              <span class="ledger-number">{String(index + 1).padStart(2, '0')}</span>
              <span>
                <small>{resource.type}</small>
                <strong>{resource.title}</strong>
                <em>{resource.note}</em>
              </span>
              <ArrowUpRight size={18} aria-hidden="true" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="journey-section shell" aria-labelledby="journey-heading">
    <div class="section-heading compact">
      <p class="eyebrow">DEVELOPER JOURNEY</p>
      <h2 id="journey-heading">从第一帧，到第一个公开作品</h2>
    </div>
    <ol class="journey-track">
      <li>
        <span>01</span>
        <BookOpen size={22} aria-hidden="true" />
        <strong>读懂硬件</strong>
        <p>屏幕、触摸、电源和 FPC 接口。</p>
      </li>
      <li>
        <span>02</span>
        <Zap size={22} aria-hidden="true" />
        <strong>点亮屏幕</strong>
        <p>复现最小工程，再增加复杂度。</p>
      </li>
      <li>
        <span>03</span>
        <Hand size={22} aria-hidden="true" />
        <strong>接入触摸</strong>
        <p>使用 GT911 官方组件和板级适配。</p>
      </li>
      <li>
        <span>04</span>
        <GitFork size={22} aria-hidden="true" />
        <strong>分享作品</strong>
        <p>通过 Issue 与 PR 加入展示墙。</p>
      </li>
    </ol>
  </section>

</SiteLayout>
