---
import { Hand, ScanLine } from 'lucide-astro';
---

<figure class="screen-schematic" aria-label="4.7 英寸电子纸模组示意图">
  <div class="dimension dimension-top"><span>684 px</span></div>
  <div class="dimension dimension-side"><span>1216 px</span></div>
  <div class="screen-frame">
    <div class="screen-paper">
      <div class="screen-meta">
        <span>OPENEPD / REV.A</span>
        <span>04.7"</span>
      </div>
      <div class="screen-title">
        <span>电子纸开发</span>
        <strong>从资料<br />到作品</strong>
      </div>
      <div class="screen-grid" aria-hidden="true"></div>
      <div class="screen-touch">
        <Hand size={18} aria-hidden="true" />
        <span>GT911 · 5 POINT</span>
      </div>
    </div>
    <div class="screen-fpc" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span><span></span>
    </div>
  </div>
  <figcaption>
    <ScanLine size={16} aria-hidden="true" />
    E0470A01-AF-S / BLACK &amp; WHITE
  </figcaption>
</figure>
